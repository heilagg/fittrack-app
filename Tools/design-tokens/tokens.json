{
  "$description": "Дизайн-токены FitTrack, направление D. Формат — W3C Design Tokens (DTCG): $type наследуется группе, ссылки {group.token}, размеры — {value, unit}. Источник правды для всех платформ: CSS генерирует Tools/design-tokens/build.mjs, вывод для Swift добавляется отдельной целью в targets/. Значения с $extensions.fittrack.origin = derived выведены из решённых, а не заданы в решении по дизайну.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#0D0E11", "$description": "Фон страницы" },
    "surface": { "$value": "#17191F", "$description": "Поверхность карточки" },
    "nav": { "$value": "#12141A", "$description": "Нижняя навигация" },
    "border": { "$value": "#262A32", "$description": "Граница" },
    "text": { "$value": "#F2F4F7", "$description": "Текст" },
    "text-muted": { "$value": "#9AA3AF", "$description": "Приглушённый текст" },
    "accent": { "$value": "#D2FF4D", "$description": "Акцент" },
    "on-accent": { "$value": "#0D0E11", "$description": "Текст на акценте" },
    "accent-chip-bg": { "$value": "#28310F", "$description": "Фон акцентного чипа" },
    "progress-inactive": { "$value": "#262A32", "$description": "Неактивный сегмент прогресса" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": { "$value": ["Space Grotesk", "Manrope", "sans-serif"], "$description": "Google Fonts. У Space Grotesk нет кириллицы: русский текст рисует Manrope, запасной — sans-serif" }
    },
    "weight": {
      "$type": "fontWeight",
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "typography": {
    "$type": "typography",
    "screen-title": {
      "$description": "Заголовок экрана",
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontSize": { "value": 36, "unit": "px" },
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.1
      }
    },
    "exercise-title": {
      "$description": "Название упражнения; на онбординге — заголовок шага",
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontSize": { "value": 30, "unit": "px" },
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.15
      }
    },
    "body": {
      "$description": "Основной текст",
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": "{font.weight.semibold}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.4
      }
    },
    "caption": {
      "$description": "Подпись",
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontSize": { "value": 14, "unit": "px" },
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.4
      }
    },
    "chip": {
      "$description": "Чип",
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontSize": { "value": 13, "unit": "px" },
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.2
      }
    },
    "weight-hero": {
      "$description": "Крупный вес на экране подхода",
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontSize": { "value": 80, "unit": "px" },
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": { "value": -3, "unit": "px" },
        "lineHeight": 1
      }
    },
    "reps": {
      "$description": "Повторы; на таймере отдыха — отсчёт",
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontSize": { "value": 46, "unit": "px" },
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1
      }
    },
    "unit": {
      "$description": "«кг» рядом с крупным весом",
      "$extensions": { "fittrack": { "origin": "derived" } },
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontSize": { "value": 24, "unit": "px" },
        "fontWeight": "{font.weight.semibold}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "card": { "$value": { "value": 22, "unit": "px" }, "$description": "Карточка" },
    "primary-button": { "$value": { "value": 18, "unit": "px" }, "$description": "Главная кнопка" },
    "control": { "$value": { "value": 16, "unit": "px" }, "$description": "Кнопки фидбэка; по ним же — прочие кнопки, поля ввода и варианты ответа" },
    "chip": { "$value": { "value": 999, "unit": "px" }, "$description": "Чипы" },
    "circle": { "$value": { "value": 999, "unit": "px" }, "$description": "Полностью круглое: кнопки «−»/«+», дни недели" }
  },
  "space": {
    "$type": "dimension",
    "page-gutter": { "$value": { "value": 20, "unit": "px" }, "$description": "Поля страницы" },
    "card": { "$value": { "value": 20, "unit": "px" }, "$description": "Внутренний отступ карточки" },
    "card-hero": { "$value": { "value": 22, "unit": "px" }, "$description": "Внутренний отступ карточки подхода" },
    "xs": { "$value": { "value": 4, "unit": "px" }, "$extensions": { "fittrack": { "origin": "derived" } } },
    "sm": { "$value": { "value": 8, "unit": "px" }, "$extensions": { "fittrack": { "origin": "derived" } } },
    "md": { "$value": { "value": 12, "unit": "px" }, "$extensions": { "fittrack": { "origin": "derived" } } },
    "lg": { "$value": { "value": 16, "unit": "px" }, "$extensions": { "fittrack": { "origin": "derived" } } },
    "xl": { "$value": { "value": 24, "unit": "px" }, "$extensions": { "fittrack": { "origin": "derived" } } },
    "xxl": { "$value": { "value": 32, "unit": "px" }, "$extensions": { "fittrack": { "origin": "derived" } } }
  },
  "size": {
    "$type": "dimension",
    "primary-button-height": { "$value": { "value": 58, "unit": "px" }, "$description": "Высота главной кнопки" },
    "feedback-button-height": { "$value": { "value": 56, "unit": "px" }, "$description": "Высота кнопок фидбэка" },
    "bottom-nav-height": { "$value": { "value": 72, "unit": "px" }, "$description": "Высота нижней навигации" },
    "touch-target-min": { "$value": { "value": 44, "unit": "px" }, "$description": "Минимальная цель нажатия" },
    "round-button": { "$value": { "value": 56, "unit": "px" }, "$description": "Круглые кнопки «−»/«+»", "$extensions": { "fittrack": { "origin": "derived" } } },
    "day-circle": { "$value": { "value": 44, "unit": "px" }, "$description": "Кружок дня в календаре недели", "$extensions": { "fittrack": { "origin": "derived" } } },
    "check": { "$value": { "value": 20, "unit": "px" }, "$description": "Радио и чекбокс внутри строки варианта", "$extensions": { "fittrack": { "origin": "derived" } } },
    "column-max": { "$value": { "value": 480, "unit": "px" }, "$description": "Ширина колонки на широком экране", "$extensions": { "fittrack": { "origin": "derived" } } },
    "border": { "$value": { "value": 1, "unit": "px" }, "$description": "Толщина границы", "$extensions": { "fittrack": { "origin": "derived" } } },
    "focus-ring": { "$value": { "value": 2, "unit": "px" }, "$description": "Толщина кольца фокуса", "$extensions": { "fittrack": { "origin": "derived" } } },
    "focus-ring-offset": { "$value": { "value": 2, "unit": "px" }, "$description": "Зазор кольца фокуса", "$extensions": { "fittrack": { "origin": "derived" } } },
    "progress-segment": { "$value": { "value": 4, "unit": "px" }, "$description": "Высота сегмента прогресса", "$extensions": { "fittrack": { "origin": "derived" } } }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.4, "$description": "Неактивные кнопки", "$extensions": { "fittrack": { "origin": "derived" } } }
  },
  "motion": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" }, "$description": "Смена цвета кнопки; отключается при prefers-reduced-motion", "$extensions": { "fittrack": { "origin": "derived" } } }
  }
}
